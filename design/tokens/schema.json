{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TUIVORY draft token document",
  "type": "object",
  "required": [
    "format",
    "roles",
    "palettes"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "tuivory.tokens.draft"
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "palettes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^(dark|light|blackwhite)-(8|16|256|truecolor)$": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/pair"
          }
        }
      }
    }
  },
  "$defs": {
    "pair": {
      "type": "object",
      "required": [
        "foreground",
        "background",
        "referenceForeground",
        "referenceBackground",
        "fontWeight"
      ],
      "additionalProperties": false,
      "properties": {
        "foreground": {
          "type": "string",
          "pattern": "^(#[0-9A-Fa-f]{6}|0|[1-9][0-9]{0,2})$"
        },
        "background": {
          "type": "string",
          "pattern": "^(#[0-9A-Fa-f]{6}|0|[1-9][0-9]{0,2})$"
        },
        "referenceForeground": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "referenceBackground": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "fontWeight": {
          "enum": [
            "none",
            "bold"
          ]
        }
      }
    }
  }
}
